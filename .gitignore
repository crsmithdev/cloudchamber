# Google Drive for Desktop scratch
.tmp.drivedownload/
.tmp.driveupload/

# Python
__pycache__/
*.py[cod]

# Regenerable pipeline output. `pipeline harvest` rebuilds the pool from
# sources/ at any time. Two files here are DELIBERATELY NOT ignored:
#   facet-stats.json  is the baseline every dimension score is relative to.
#                     Regenerable in principle, but re-fitting it moves every
#                     passage's facets under verdicts already recorded against
#                     them, so the fitted copy is tracked and shared.
#   themes.jsonl      is not regenerable at all. Passages come back from
#                     `pipeline harvest`; themes are written by a session
#                     against the grain and nothing reproduces them. It was
#                     ignored on the assumption it behaved like the pool.
extracted/examples.jsonl
extracted/packets/

# Agent worktrees
.worktrees/

# Scratch a session serves from the repo: mockups and the like. The phase B
# world stylesheets and their generator are tracked; fixtures and renders are not.
tmp/*
!tmp/mockups/
tmp/mockups/*
!tmp/mockups/worlds.ts
!tmp/mockups/tide-table.css
!tmp/mockups/galley-proof.css

# Working store: rebuildable from sources/ plus bank/verdicts.jsonl and bank/themes.jsonl
data/
.pytest_cache/

node_modules/
app/ui/dist/
.playwright-cli/

# impeccable per-developer config
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/review/
