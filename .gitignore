# The private corpus, linked in as one directory. See the README.
/corpus

# Pipeline output: one directory per draw, the exported drafts, and the reports.
/briefs/
/drafts/
/output/

# The store lives in ~/.cloudchamber/; an old copy may remain here.
/data/

# Build output and tool state
node_modules/
app/ui/dist/
__pycache__/
*.py[cod]
.pytest_cache/
.playwright-cli/
.worktrees/

# Mockup scratch. The world stylesheets and their generator are tracked;
# fixtures and renders are not.
tmp/*
!tmp/mockups/
tmp/mockups/*
!tmp/mockups/worlds.ts
!tmp/mockups/tide-table.css
!tmp/mockups/galley-proof.css

# impeccable per-developer state
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/review/
