# Prose repo: normalise to LF in the index and in the worktree.
# Prevents CRLF churn if a Windows editor rewrites a file.
* text=auto eol=lf

# Treat markdown as text explicitly, and diff it by paragraph.
*.md text eol=lf diff=markdown

# ideas-v2.md is generated by build.py from parts/ and stories/.
# Marking it generated collapses its diff on GitHub, so review the story file instead.
ideas-v2.md linguist-generated=true
