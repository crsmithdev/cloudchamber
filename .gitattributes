# Prose repo: normalise to LF in the index and in the worktree.
# Prevents CRLF churn if a Windows editor rewrites a file.
* text=auto eol=lf

# Treat markdown as text explicitly, and diff it by paragraph.
*.md text eol=lf diff=markdown

# The source PDFs under sources/ are tracked. Mark them binary explicitly: the
# `* text=auto` rule above relies on git's own binary detection, and a
# mis-detected PDF would be corrupted by line-ending conversion on checkout.
*.pdf binary
